load(file = "/Users/yishen/Documents/graphical_lasso/real_tcga/df_dnam.RData") # 299914 * 893
df_gene <- vroom("/Users/yishen/Documents/graphical_lasso/real_tcga/TCGA-BRCA.star_tpm.tsv")
df_gene = as.data.frame(df_gene) # 60660 * 1227
rownames(df_gene) = df_gene[, 1]
df_gene = df_gene[, -1] # 60660 * 1226
# df_prot <- vroom("/Users/yishen/Documents/graphical_lasso/real_tcga/TCGA-BRCA.protein.tsv")
# df_prot = as.data.frame(df_prot) # 487 * 920
# protNA <- which(is.na(df_prot), arr.ind = TRUE)
# df_prot = df_prot[-protNA[, 1], ]  # 487 * 920
# rownames(df_prot) = df_prot[, 1]
# df_prot = df_prot[, -1]
# save(df_prot, file = "/Users/yishen/Documents/graphical_lasso/real_tcga/df_prot.RData")
load(file = "/Users/yishen/Documents/graphical_lasso/real_tcga/df_prot.RData") # 217 * 919
df_metadata <- vroom("/Users/yishen/Documents/graphical_lasso/real_tcga/TCGA-BRCA.clinical.tsv")
df_metadata = as.data.frame(df_metadata)
rownames(df_metadata) <- df_metadata[, 1]
df_metadata = df_metadata[, -1]
## DNAm
df_dnam_meta <- df_metadata[match(colnames(df_dnam), rownames(df_metadata)), ]
dnam_ind <- with(df_dnam_meta, which(
disease_type == "Ductal and Lobular Neoplasms" &
!is.na(ajcc_pathologic_stage.diagnoses) &
ajcc_pathologic_stage.diagnoses != "Stage X"
))
df_dnam = df_dnam[, dnam_ind] # 299914 * 838
df_dnam_meta = df_dnam_meta[dnam_ind, ]
## gene expression
df_gene_meta <- df_metadata[match(colnames(df_gene), rownames(df_metadata)), ]
gene_ind <- with(df_gene_meta, which(
disease_type == "Ductal and Lobular Neoplasms" &
!is.na(ajcc_pathologic_stage.diagnoses) &
ajcc_pathologic_stage.diagnoses != "Stage X"
))
df_gene = df_gene[, gene_ind] # 60660 * 1154
df_gene_meta = df_gene_meta[gene_ind, ]
## protein
df_prot_meta <- df_metadata[match(colnames(df_prot), rownames(df_metadata)), ]
prot_ind <- with(df_prot_meta, which(
disease_type == "Ductal and Lobular Neoplasms" &
!is.na(ajcc_pathologic_stage.diagnoses) &
ajcc_pathologic_stage.diagnoses != "Stage X"
))
df_prot = df_prot[, prot_ind] # 217 * 869
df_prot_meta = df_prot_meta[prot_ind, ]
View(df_metadata)
View(df_gene)
gene_dnam_prot_ind_name <- Reduce(intersect, list(colnames(df_gene), colnames(df_dnam), colnames(df_prot)))
df_gene_dnam_prot = t(rbind(df_gene[, match(gene_dnam_prot_ind_name, colnames(df_gene))],
df_dnam[, match(gene_dnam_prot_ind_name, colnames(df_dnam))],
df_prot[, match(gene_dnam_prot_ind_name, colnames(df_prot))]))
df_618 = t(rbind(df_gene[, match(gene_dnam_prot_ind_name, colnames(df_gene))],
df_dnam[, match(gene_dnam_prot_ind_name, colnames(df_dnam))],
df_prot[, match(gene_dnam_prot_ind_name, colnames(df_prot))]))
save(df_618, file = "/Users/yishen/Documents/graphical_lasso/real_tcga/df_618.RData")
View(df_618)
df_618 = as.data.frame(df_618)
View(df_618)
save(df_618, file = "/Users/yishen/Documents/graphical_lasso/real_tcga/df_618.RData")
library(vroom)
library(table1)
library(dplyr)
library(stringr)
library(matrixStats)
library(edgeR)
options(digits = 15)
load(file = "/Users/yishen/Documents/graphical_lasso/real_tcga/df_618.RData")
View(df_618)
df_gene <- df_618[, 1:60660]
df_dnam <- df_618[, 60661:(60660+299914)]
df_prot <- df_618[, (60660+299914+1):(60660+299914+217)]
## read phenotype
df_metadata <- vroom("/Users/yishen/Documents/graphical_lasso/real_tcga/TCGA-BRCA.clinical.tsv")
df_metadata = as.data.frame(df_metadata)
rownames(df_metadata) <- df_metadata[, 1]
df_metadata = df_metadata[, -1]
df_metadata <- df_metadata[match(rownames(df_618), rownames(df_metadata)), ]
df_metadata <- df_metadata %>%
mutate(ajcc_pathologic_stage.diagnoses = case_when(
ajcc_pathologic_stage.diagnoses %in% c("Stage IA", "Stage IB") ~ "Stage I",
ajcc_pathologic_stage.diagnoses %in% c("Stage IIA", "Stage IIB") ~ "Stage II",
ajcc_pathologic_stage.diagnoses %in% c("Stage IIIA", "Stage IIIB", "Stage IIIC") ~ "Stage III",
TRUE ~ ajcc_pathologic_stage.diagnoses
))
View(df_metadata)
table(df_metadata$ajcc_pathologic_stage.diagnoses)
View(df_metadata)
View(df_gene)
total_threshold = 100
gene_keep <- which(colSums(df_gene) >= total_threshold)
ftd_gene = df_gene[, gene_keep]
DGE_ftd_gene = DGEList(t(ftd_gene))
gene_TMM <- normLibSizes(DGE_ftd_gene, method = "TMM")
ftd_TMM_gene = t(cpm(gene_TMM, normalized.lib.sizes = TRUE, log = TRUE, prior.count = 1))
View(ftd_TMM_gene)
View(ftd_gene)
stage <- factor(df_metadata$ajcc_pathologic_stage.diagnoses, levels = c("Stage I", "Stage II", "Stage III", "Stage IV"))
rm(stage)
gene_stage <- factor(df_metadata$ajcc_pathologic_stage.diagnoses, levels = c("Stage I", "Stage II", "Stage III", "Stage IV"))
gene_stage
?aov
gene_pvals <- apply(ftd_TMM_gene, 2, function(x) {
fit <- aov(x ~ stage)
summary(fit)[[1]][["Pr(>F)"]][1]
})
gene_pvals <- apply(ftd_TMM_gene, 2, function(x) {
fit <- aov(x ~ gene_stage)
summary(fit)[[1]][["Pr(>F)"]][1]
})
gene_pvals
hist(gene_pvals)
hist(gene_pvals)
